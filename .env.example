OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Desde Milestone 5, estos valores solo se usan para sembrar `settings.json`
# (en `app.getPath('userData')`) la primera vez que arranca la app — a partir de ahí
# el panel de configuración del widget es la fuente de verdad y estas variables se ignoran.

# Coordenadas del punto central del radar (por defecto: aeropuerto de Barajas, Madrid)
HOME_LATITUDE=40.4719
HOME_LONGITUDE=-3.5626

# Bounding box de consulta a OpenSky — ~35 km alrededor de casa en las 4 direcciones,
# para cubrir el nivel de zoom más lejano del radar (30 km). Se usa solo para derivar
# el radio inicial (`bboxRadiusKm`) del primer arranque.
BBOX_LAMIN=40.15
BBOX_LOMIN=-3.98
BBOX_LAMAX=40.80
BBOX_LOMAX=-3.15

# Intervalo de polling en segundos (valor inicial; luego editable desde el panel de configuración)
POLL_INTERVAL_SECONDS=25
