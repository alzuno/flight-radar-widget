OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Coordenadas del punto central del radar (por defecto: aeropuerto de Barajas, Madrid)
HOME_LATITUDE=40.4719
HOME_LONGITUDE=-3.5626

# Bounding box de consulta a OpenSky (por defecto cubre Bernabéu + Barajas)
BBOX_LAMIN=40.35
BBOX_LOMIN=-3.75
BBOX_LAMAX=40.55
BBOX_LOMAX=-3.45

# Intervalo de polling en segundos
POLL_INTERVAL_SECONDS=25
